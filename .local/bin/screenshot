#!/usr/bin/bash

f="/tmp/$(date +%F_%T)"
maim -s "${f}.png"
dims=$(identify -format "%wx%h" "${f}.png")
mv "${f}.png" "${f}_${dims}.png"
xclip -selection clipboard -target image/png -i "${f}_${dims}.png"

echo "Screenshot saved to ${f}_${dims}.png and copied to clipboard."
notify-send -i "${f}_${dims}.png" "Screenshot" "Area screenshot taken"
